{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLgit",
  "version": "0.1.0",
  "identifier": "app.flgit.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FLgit",
        "width": 64,
        "height": 64,
        "minWidth": 56,
        "minHeight": 56,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
